# Modo simulação: gera pista sintética e simula resposta da ESP32 sem hardware conectado
ROVER_MOCK_MODE=true

# Endereços da ESP32-WROVER-DEV (padrão SoftAP: 192.168.4.1)
ROVER_ESP32_STREAM_URL=http://192.168.4.1:81/stream
ROVER_ESP32_WS_URL=ws://192.168.4.1:82

# Modelo de IA (.onnx exportado do YOLOv8/YOLO11)
ROVER_MODEL_PATH=ai/models/pavement_yolov8n.onnx
ROVER_CONFIDENCE_THRESHOLD=0.45

# Pasta para salvar capturas de dataset e evidências
ROVER_CAPTURE_DIR=ai/dataset/raw
